# AgentTrace environment. Copy to .env (gitignored) and fill in.
# One file at the repo root: api/ loads it via python-dotenv, web/ via @next/env (see web/next.config.ts).
# On Render, set the same names in the dashboard instead (render.yaml declares them).
# Names only below: real values go in .env, never here.
#
# Fill phase by phase. `python api/scripts/check_env.py --phase N` lists what is still missing.

# ============================================================
# PHASE 0 - access, skeleton, deploy  (fill now)
# ============================================================

# dev | prod. DEV_WORKSPACE_ID shortcuts only work when ENV=dev.
ENV=dev

# Comma-separated browser origins allowed by CORS. Add your Render web URL here
# (and in the Render dashboard) once you have it, e.g. https://agenttrace-web.onrender.com
WEB_ORIGINS=http://localhost:3000

# Where the web app finds the API. Inlined at BUILD time by Next.js:
# on Render, set it before the web service builds, and rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# SurrealDB Cloud instance. Give the bare host, e.g. wss://<instance>.<region>.surreal.cloud
# (the Python SDK appends /rpc itself).
SURREAL_URL=
SURREAL_NS=
SURREAL_DB=
# Either user+pass ...
SURREAL_USER=
SURREAL_PASS=
# ... or a token (takes precedence if set). Check which your instance gives you.
SURREAL_TOKEN=
# root | namespace | database - the level your SURREAL_USER was created at. Cloud default is root.
SURREAL_AUTH_LEVEL=root

# Anthropic console key. Set a spend limit in the console now. Not used by the API until Phase 3.
ANTHROPIC_API_KEY=

# ============================================================
# PHASE 3 - demo workflow + oracle
# ============================================================

# era | fixtures. Falls back to fixtures/company.json if Era is not working by Thu 12:00.
TOOLS_BACKEND=fixtures

# Account the demo workflow writes a brief for. Pick with `python api/scripts/pick_account.py`
# (Era). The fixtures backend has acct-1.
DEMO_ACCOUNT_ID=acct-1

# The one workspace the public, no-sign-in /demo routes serve. Filled by scripts/seed_demo.py.
DEMO_WORKSPACE_ID=demo

# `era new` writes these into its own .env: copy them over. The code reads only these four
# (a Bearer-token header line each); the other ERA_* lines are not used.
ZENDESK_BASE_URL=
ZENDESK_MCP_HEADER=
SALESFORCE_BASE_URL=
SALESFORCE_MCP_HEADER=

# ============================================================
# PHASE 4 - ingest + query API
# ============================================================

# Dev-only workspace for GET routes before Clerk lands (Phase 7). Ignored unless ENV=dev.
DEV_WORKSPACE_ID=dev

# For the SDK's HttpSink and scripts/record_demo.py. The key is minted by the API in Phase 4
# (shown once), not issued by a third party.
AGENTTRACE_API_URL=http://localhost:8000
AGENTTRACE_INGEST_KEY=

# ============================================================
# PHASE 6 - experiment budget caps
# ============================================================

MAX_N=8
MAX_TOKENS_PER_EXPERIMENT=500000
DAILY_EXPERIMENTS_PER_USER=10

# ============================================================
# PHASE 7 - Clerk (enable Organizations in the Clerk dashboard first)
# ============================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard > API keys > "Frontend API URL" gives the issuer; JWKS is <issuer>/.well-known/jwks.json
CLERK_ISSUER=
CLERK_JWKS_URL=

# Where Clerk sends people to sign in / up (our own pages) and after they do.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/runs
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/runs

# ============================================================
# PHASE 11 - SurrealDB Agent Memory (formerly "Spectron")
# ============================================================

SPECTRON_ENDPOINT=
SPECTRON_API_KEY=
SPECTRON_CONTEXT=
